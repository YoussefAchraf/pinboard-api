// Prisma schema - the single source of truth for the database structure.
//
// Workflow: edit models here -> `npm run db:migrate -- --name <change>` (creates a migration in
// prisma/migrations and regenerates the client) -> commit schema + migration together.
// CI / production apply migrations with `npm run db:deploy` (compose service "migrate").
//
// Conventions (see AGENTS-SENIOR-BACKEND-DB.md):
// - Model names PascalCase singular; map tables/columns to snake_case with @@map / @map.
// - Every FK indexed; unique constraints in the DB even when the app validates.
// - Timestamps: DateTime @db.Timestamptz(3), UTC.
// - Additive migrations first; destructive changes ship in two deploys.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"                                   // project compiles to CommonJS (tsc + ts-jest)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]  // Alpine runtime image
}

datasource db {
  provider = "postgresql"
}

