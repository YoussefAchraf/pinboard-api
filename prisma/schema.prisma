// Prisma schema - the single source of truth for the database structure.
//
// Workflow: edit models here -> `npm run db:migrate -- --name <change>` (creates a migration in
// prisma/migrations and regenerates the client) -> commit schema + migration together.
// CI / production apply migrations with `npm run db:deploy` (compose service "migrate").
//
// Conventions (see AGENTS-SENIOR-BACKEND-DB.md):
// - Model names PascalCase singular; map tables/columns to snake_case with @@map / @map.
// - Every FK indexed; unique constraints in the DB even when the app validates.
// - Timestamps: DateTime @db.Timestamptz(3), UTC.
// - Additive migrations first; destructive changes ship in two deploys.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"                                   // project compiles to CommonJS (tsc + ts-jest)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]  // Alpine runtime image
}

datasource db {
  provider = "postgresql"
}

// User - contracts/domain-model.md section 2 (task 001: model + init migration only).
// Email: stored lowercase (CHECK users_email_lowercase, added by hand in the init migration) + unique,
// which makes uniqueness case-insensitive. Role and status are Postgres enums.

enum RoleName {
  admin
  member

  @@map("role_name")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash")
  firstname    String     @db.VarChar(100)
  lastname     String     @db.VarChar(100)
  roleName     RoleName   @default(member) @map("role_name")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
